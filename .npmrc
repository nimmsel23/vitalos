# eslint@10 in fitness-dev kollidiert mit eslint-plugin-react@7.37 (peer <=9).
# Bis fitness-dev auf eslint 9 zurückgeht: Peer-Konflikte nicht hart failen lassen.
# legacy-peer-deps ist npm-spezifisch, bleibt als Doku/Fallback falls npm wieder
# genutzt wird. pnpm-Äquivalent: strict-peer-dependencies=false.
legacy-peer-deps=true
strict-peer-dependencies=false

# pnpms strikte node_modules-Isolation deckt laufend "Phantom-Dependencies"
# auf (Pakete, die intern @scope/sub-packages bare importieren, ohne sie
# selbst als eigene Dependency zu deklarieren — lief unter npm nur zufällig
# per flachem Hoisting). Bei den vielen Apps/Libraries hier (firebase-Kette,
# recharts/victory-vendor/d3-*, framer-motion/motion-dom, remark-gfm/
# micromark-* ...) ist das Einzeln-Nachtragen jeder transitiven Dependency
# nicht mehr sinnvoll pflegbar. shamefully-hoist stellt npm-artiges flaches
# Hoisting wieder her und beendet das Whack-a-Mole (2026-10-13).
shamefully-hoist=true
