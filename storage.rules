rules_version = '2';
// Projekt-globale Storage-Rules für fitness-aos (SSOT, wie firestore.rules).
// Deploy NUR über .github/workflows/deploy-firestore-rules.yml — App-Repos
// deployen keine Rules (sonst überschreiben sie sich gegenseitig).
// Abschnitt 6Pack: eigene Übungsvideos (6pack-dev, ExerciseVideoUpload).
// Lesen: nur angemeldete Nutzer, wie die übrigen Firebase-Daten der App.
// Gäste bleiben beim Katalog-Video.
// Schreiben: nur video/*, höchstens 100 MB, höchstens ein Objekt pro Konto
// und Übung (Dateiname = request.auth.uid). customMetadata.uploaderUid muss
// dieselbe UID sein. Überschreiben und Löschen nur, wenn das vorhandene
// Objekt von diesem Konto stammt.
service firebase.storage {
  match /b/{bucket}/o {
    function videoUpload(exerciseId, fileName) {
      return request.auth != null
        && exerciseId.matches('^[a-z][a-z0-9_]{0,63}$')
        && request.auth.uid.matches('^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$')
        && fileName == request.auth.uid
        && request.resource.size > 0
        && request.resource.size <= 100 * 1024 * 1024
        && request.resource.contentType.matches('video/.+')
        && 'uploaderUid' in request.resource.metadata
        && request.resource.metadata.uploaderUid == request.auth.uid;
    }
    match /exerciseVideos/{exerciseId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if videoUpload(exerciseId, fileName);
      allow update: if videoUpload(exerciseId, fileName)
        && 'uploaderUid' in resource.metadata
        && resource.metadata.uploaderUid == request.auth.uid;
      allow delete: if request.auth != null
        && 'uploaderUid' in resource.metadata
        && resource.metadata.uploaderUid == request.auth.uid;
    }
  }
}
