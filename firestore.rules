rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Konsolidiertes SSOT-Ruleset für das Firebase-Projekt fitness-aos.
// Deployed NUR aus ~/vitalos (firebase deploy --only firestore:rules).
// fitness-dev und fuel-dev deployen KEINE eigenen Rules mehr — ihre
// firebase.json haben keinen firestore-Block. Vorher: fitness-dev hatte
// `allow read, write: if true` und überschrieb fuels uid-scoped Rules.
//
// Coach-Rolle: Firestore-Doc roles/{uid} mit { role: "coach" } anlegen
// (einmalig via Firebase Console oder Admin SDK). Coach darf Klienten-Daten
// lesen/schreiben (Inbox-Review, Plan-Zuweisung). Server-Sync-Prozesse
// (firestore-mirror.mjs, sync_gateway) laufen mit Admin SDK und sind von
// Rules nicht betroffen.
//
// App-Rules werden in ihren App-Repos gepflegt und hier zentral registriert:
// - fitness-app/firestore.rules
// - fuel-app/firestore.rules
// - plan-app/firestore.rules.part (Modul-Fragment: fitness/{uid}/** inkl. macrocycles, per scripts/build-rules.mjs eingebettet)
// - journal-app/firestore.rules.part (Modul-Fragment, per scripts/build-rules.mjs eingebettet)
// - coach-dev/firestore.rules (Repo liegt bewusst ausserhalb von ~/vitalos)
// - plan-dev/firestore.rules (Repo liegt bewusst ausserhalb von ~/vitalos;
//   nutzt ausschliesslich bereits registrierte fitness/{uid}/...-Pfade,
//   keine neuen Collections)
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function authed() {
      return request.auth != null;
    }
    function owner(uid) {
      return authed() && request.auth.uid == uid;
    }
    // Coach = Custom Claim (set_admin.py) ODER roles-Doc ODER Alpha-UID
    // (hartkodierte UID stammt aus den alten fitness-dev-Rules — Fallback,
    // falls Claim/roles-Doc auf dem Account nie gesetzt wurden)
    function isCoach() {
      return authed() && (
        request.auth.token.coach == true
        || request.auth.uid == '59ole36uNpNwml5H6VDYCXyCME92'
        || (exists(/databases/$(database)/documents/roles/$(request.auth.uid))
            && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'coach')
      );
    }

    // Rollen: eigene Rolle lesbar, Schreiben nur via Console/Admin SDK
    match /roles/{uid} {
      allow read: if owner(uid);
      allow write: if false;
    }

    // Private 6Pack selfies: separate from coach-readable fitness/users trees.
    match /sixpackSelfies/{uid}/photos/{photoId} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && photoId.matches('[A-Za-z0-9_-]{1,128}')
        && request.resource.data.keys().hasOnly(['date', 'dataUrl'])
        && request.resource.data.date is string
        && request.resource.data.date.size() <= 32
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.size() <= 700000
        && request.resource.data.dataUrl.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+');
    }

    // ── Fitness (inkl. Journal/Habits/Learn der vitalos-Shell) ──────────────
    // Userdaten: /fitness/{uid}/sessions|plan|journal|habits|habitRecords|
    //            habitJournals|inbox|profile|…
    // >>> module: plan-app/firestore.rules.part
    // Plan-Modul (plan-dev/firestore.rules.part): wird von ~/vitalos (scripts/build-rules.mjs)
    // in firestore.rules eingebettet und nur von dort deployed. Nutzt owner()/isCoach().
    // Pläne (macrocycles): der Besitzer darf nur Pläne schreiben, die er selbst angelegt hat
    // (coachUid == uid, Self-Service). Coach-Pläne und ihre Versionen sind für den Klienten
    // schreibgeschützt; Versionen sind nach dem Anlegen unveränderlich. Completions bleiben offen.
    match /fitness/{uid}/{document=**} {
      allow read: if owner(uid) || isCoach();
      allow write: if isCoach() || (owner(uid) && !string(request.path).matches('.*/macrocycles/.*'));
    }
    match /fitness/{uid}/macrocycles/{planId} {
      allow create: if owner(uid) && request.resource.data.coachUid == uid;
      allow update: if owner(uid) && resource.data.coachUid == uid && request.resource.data.coachUid == uid;
      allow delete: if owner(uid) && resource.data.coachUid == uid;
      match /versions/{versionId} {
        allow create: if owner(uid)
          && get(/databases/$(database)/documents/fitness/$(uid)/macrocycles/$(planId)).data.coachUid == uid;
      }
      // Lesebestätigung: der Klient legt je Version einmalig ein Dokument an (unveränderlich, nur eigene Felder).
      match /receipts/{receiptId} {
        allow create: if owner(uid)
          && request.resource.data.keys().hasOnly(['planId', 'version', 'readAt'])
          && request.resource.data.planId == planId
          && request.resource.data.version is int
          && receiptId == 'v' + string(request.resource.data.version);
      }
      match /completions/{completionId} {
        allow write: if owner(uid);
      }
    }
    // <<< module

    // >>> module: journal-app/firestore.rules.part
    // Journal-v2-Apps (journal-dev): journal/{uid}/frame/{domain} (Game v2 · Frame Map),
    // journal/{uid}/settings/{door,taskchampion} u. a. Nur der Besitzer; Coach bewusst ausgenommen.
    // Modul-Fragment: wird von ~/vitalos (scripts/build-rules.mjs) in firestore.rules eingebettet
    // und von dort deployed. Nutzt owner() aus dem Root-Ruleset.
    match /journal/{uid}/{document=**} {
      allow read, write: if owner(uid);
    }
    // <<< module

    // Geteilte Exercise-KB (pseudo-uid "kb"): alle lesen, nur Coach schreibt
    // (approveInbox promoted Inbox-Einträge nach fitness/kb/exercises)
    match /fitness/kb/{document=**} {
      allow read: if authed();
      allow write: if isCoach();
    }

    // Coach-Review über alle Klienten-Inboxen (collectionGroup "inbox");
    // User erreicht eigene Einträge via userId-Feld (fitness-dev PWA)
    match /{path=**}/inbox/{id} {
      allow read:  if isCoach() || (authed() && resource.data.userId == request.auth.uid);
      // Users write inbox via direct path /fitness/{uid}/inbox (per-user rule above).
      // CollectionGroup write = coach only (approve/reject).
      allow write: if isCoach();
    }

    // collectionGroup-Queries der fitness-dev PWA (Coach-Feed + eigene Daten)
    match /{path=**}/sessions/{sessionId} {
      allow read: if isCoach() || (authed() && resource.data.userId == request.auth.uid);
    }
    match /{path=**}/profile/{doc} {
      // Own profile accessible via /fitness/{uid}/... (per-user rule above).
      // CollectionGroup: coach-only — prevents cross-user profile leaks.
      allow read: if isCoach();
    }
    match /{path=**}/habitJournals/{doc} {
      allow read:  if isCoach() || (authed() && resource.data.userId == request.auth.uid);
      // request.resource.data = incoming doc (works on create + update).
      // resource.data = existing doc (fails on create).
      allow write: if isCoach() || (authed() && request.resource.data.userId == request.auth.uid);
    }

    // ── Coach-App (coach-dev / vos-coach) + Plan-App (plan-dev / vos-plan) ───
    // Eigene App-Rules liegen in ~/coach-dev/firestore.rules bzw.
    // ~/plan-dev/firestore.rules. Deploybar ist nur dieses konsolidierte Set
    // aus ~/vitalos fuer das gemeinsame fitness-aos. Plan-App nutzt dieselben
    // routines/workouts/wf_workouts/macrocycles-Collections wie Coach-App,
    // keine eigenen Regeln noetig.
    match /coachInbox/{id} {
      allow read: if isCoach();
      allow write: if false;
    }
    match /coachState/{id} {
      allow read: if isCoach();
      allow write: if false;
    }
    match /coachCommands/{id} {
      allow read: if isCoach();
      allow create: if isCoach()
        && request.resource.data.keys().hasOnly(['action', 'item_id', 'uid', 'payload', 'requested_by', 'status', 'created_at'])
        && request.resource.data.requested_by == request.auth.uid
        && request.resource.data.status == 'queued'
        && request.resource.data.action in ['approve', 'reenrich', 'delete', 'link-source', 'duplicates', 'merge-duplicates']
        && request.resource.data.item_id is string
        && request.resource.data.item_id.size() > 0
        && request.resource.data.item_id.size() <= 200
        && request.resource.data.payload is map;
      allow update, delete: if false;
    }
    match /{path=**}/journal/{doc} {
      allow read: if isCoach() || (authed() && resource.data.userId == request.auth.uid);
      allow write: if isCoach();
    }
    match /{path=**}/settings/{doc} {
      allow read, write: if isCoach();
    }
    match /{path=**}/routines/{doc} {
      allow read, write: if isCoach();
    }
    match /{path=**}/workouts/{doc} {
      allow read, write: if isCoach();
    }
    match /{path=**}/wf_workouts/{doc} {
      allow read, write: if isCoach();
    }
    match /{path=**}/macrocycles/{doc} {
      allow read, write: if isCoach();
    }

    // ── Fuel (Nutrition & Supplements) ───────────────────────────────────────
    // /nutrition/{uid}/logs|journal|meta/… und /supplements/{uid}/logs|meta/…
    match /nutrition/{uid}/{document=**} {
      allow read, write: if owner(uid) || isCoach();
    }
    match /supplements/{uid}/{document=**} {
      allow read, write: if owner(uid) || isCoach();
    }

    // User-Settings (fuel cloud: users/{uid}/meta/settings)
    match /users/{uid}/{document=**} {
      allow read, write: if owner(uid) || isCoach();
    }

    // Geteilter Mikronährstoff-Katalog (pseudo-uid "public", read-only,
    // Pflege via Admin SDK/CLI)
    match /nutrition/public/{document=**} {
      allow read: if authed();
      allow write: if false;
    }

    // ── Relax (dritter Tempel, gleiche Struktur) ─────────────────────────────
    match /relax/{uid}/{document=**} {
      allow read, write: if owner(uid) || isCoach();
    }

    // ── Global Knowledge (KB-Sync via Admin SDK/CLI) ─────────────────────────
    match /knowledge/{document=**} {
      allow read: if authed();
      allow write: if false;
    }
    match /knowledge_tasks/{taskId} {
      allow read: if authed();
      allow create: if authed();
      allow update: if false;
    }
  }
}
