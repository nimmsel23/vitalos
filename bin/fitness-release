#!/usr/bin/env bash
set -euo pipefail

REAL_GIT="/usr/bin/git"
STANDALONE_DIR="/home/alpha/fitness-dev"
SUBMODULE_DIR="/home/alpha/vitalos/fitness-app"
PARENT_DIR="/home/alpha/vitalos"
SUBMODULE_NAME="fitness-app"
DEFAULT_PARENT_MESSAGE_PREFIX="chore(submodules): bump fitness-app to"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
NC='\033[0m'

usage() {
    cat <<EOF
fitness-release — push fitness-dev, merge into vitalos/fitness-app master, bump vitalos submodule pointer

Usage:
  fitness-release [--dry-run]
  fitness-release --help

Options:
  --dry-run   Print the steps without changing git state
  -h, --help  Show this help
EOF
}

info() { echo -e "${BLUE}[INFO]${NC} $*"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $*"; }
success() { echo -e "${GREEN}[OK]${NC} $*"; }
error() { echo -e "${RED}[ERROR]${NC} $*" >&2; }

DRY_RUN=0
while (($#)); do
    case "$1" in
        --dry-run)
            DRY_RUN=1
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            error "Unknown argument: $1"
            usage
            exit 1
            ;;
    esac
    shift
done

run() {
    if [[ "$DRY_RUN" -eq 1 ]]; then
        printf '[dry-run] '
        printf '%q ' "$@"
        printf '\n'
        return 0
    fi
    "$@"
}

require_dir() {
    local dir="$1"
    if [[ ! -d "$dir" ]]; then
        error "Required directory missing: $dir"
        exit 1
    fi
}

standalone_dirty() {
    [[ -n "$("$REAL_GIT" -C "$STANDALONE_DIR" status --porcelain 2>/dev/null)" ]]
}

submodule_dirty_filtered() {
    "$REAL_GIT" -C "$SUBMODULE_DIR" status --porcelain 2>/dev/null | grep -vE '^\?\? (node_modules|functions/node_modules)$' || true
}

parent_dirty_filtered() {
    "$REAL_GIT" -C "$PARENT_DIR" status --porcelain 2>/dev/null | grep -vE '^ \? (fuel-app|habit-app|journal-app|learn-dev)$' || true
}

require_clean_state() {
    local standalone_branch submodule_branch parent_branch

    standalone_branch=$("$REAL_GIT" -C "$STANDALONE_DIR" branch --show-current)
    submodule_branch=$("$REAL_GIT" -C "$SUBMODULE_DIR" branch --show-current)
    parent_branch=$("$REAL_GIT" -C "$PARENT_DIR" branch --show-current)

    [[ "$standalone_branch" == "dev" ]] || { error "Expected $STANDALONE_DIR on branch dev, found $standalone_branch"; exit 1; }
    [[ "$submodule_branch" == "master" ]] || { error "Expected $SUBMODULE_DIR on branch master, found $submodule_branch"; exit 1; }
    [[ "$parent_branch" == "master" ]] || { error "Expected $PARENT_DIR on branch master, found $parent_branch"; exit 1; }

    if standalone_dirty; then
        error "$STANDALONE_DIR has uncommitted changes. Commit or stash first."
        exit 1
    fi

    if [[ -n "$(submodule_dirty_filtered)" ]]; then
        error "$SUBMODULE_DIR has unexpected changes:"
        submodule_dirty_filtered >&2
        exit 1
    fi

    if [[ -n "$(parent_dirty_filtered)" ]]; then
        error "$PARENT_DIR has unexpected changes:"
        parent_dirty_filtered >&2
        exit 1
    fi
}

main() {
    require_dir "$STANDALONE_DIR"
    require_dir "$SUBMODULE_DIR"
    require_dir "$PARENT_DIR"
    require_clean_state

    info "Pushing fitness-dev dev -> origin/dev"
    run "$REAL_GIT" -C "$STANDALONE_DIR" push origin dev

    info "Updating fitness-app master from origin"
    run "$REAL_GIT" -C "$SUBMODULE_DIR" pull origin master

    info "Merging dev into fitness-app master"
    run "$REAL_GIT" -C "$SUBMODULE_DIR" merge dev --no-edit

    info "Pushing fitness-app master -> origin/master"
    run "$REAL_GIT" -C "$SUBMODULE_DIR" push origin master

    local new_sha short_sha parent_message
    new_sha=$("$REAL_GIT" -C "$SUBMODULE_DIR" rev-parse HEAD)
    short_sha=${new_sha:0:7}
    parent_message="$DEFAULT_PARENT_MESSAGE_PREFIX ${short_sha}"

    info "Updating vitalos submodule pointer to $short_sha"
    run "$REAL_GIT" -C "$PARENT_DIR" add "$SUBMODULE_NAME"

    if [[ "$DRY_RUN" -eq 1 ]]; then
        printf '[dry-run] %q ' "$REAL_GIT" -C "$PARENT_DIR" commit -m "$parent_message" -- "$SUBMODULE_NAME"
        printf '\n'
    else
        if "$REAL_GIT" -C "$PARENT_DIR" diff --cached --quiet -- "$SUBMODULE_NAME"; then
            warn "No submodule pointer change detected in $PARENT_DIR"
        else
            "$REAL_GIT" -C "$PARENT_DIR" commit -m "$parent_message" -- "$SUBMODULE_NAME"
        fi
    fi

    info "Pushing vitalos master -> origin/master"
    run "$REAL_GIT" -C "$PARENT_DIR" push origin master

    success "fitness release flow complete"
}

main
