#!/usr/bin/env bash
set -euo pipefail

REAL_GIT="/usr/bin/git"
VITALOS_DIR="/home/alpha/vitalos"
ENSURE_LINKS_SCRIPT="$VITALOS_DIR/bin/ensure-node-modules-symlinks.sh"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
NC='\033[0m'

declare -A STANDALONE_DIRS
declare -A SUBMODULE_DIRS
# Shell-Promotion: dev -> master (PR, vos-release-pr) -> vitalos (dieses Skript). Quelle ist origin/master der
# Standalone-Repos (Standalone-Prod); master liegt nur auf GitHub, nie lokal. Ziel ist der Branch vitalos im
# -app-Checkout, danach der Pointer-Bump im Meta-Repo.
declare -A SOURCE_BRANCHES
declare -A TARGET_BRANCHES
declare -A NOISE_PATTERNS

STANDALONE_DIRS[fitness]="/home/alpha/fitness-dev"
STANDALONE_DIRS[fuel]="/home/alpha/fuel-dev"
STANDALONE_DIRS[habits]="/home/alpha/habits-dev"
STANDALONE_DIRS[journal]="/home/alpha/journal-dev"
STANDALONE_DIRS[learn]="/home/alpha/learn-dev"
STANDALONE_DIRS[relax]="/home/alpha/relax-dev"
STANDALONE_DIRS[6pack]="/home/alpha/6pack-dev"
STANDALONE_DIRS[plan]="/home/alpha/plan-dev"
STANDALONE_DIRS[skills]="/home/alpha/skills-dev"

SUBMODULE_DIRS[fitness]="/home/alpha/vitalos/fitness-app"
SUBMODULE_DIRS[fuel]="/home/alpha/vitalos/fuel-app"
SUBMODULE_DIRS[habits]="/home/alpha/vitalos/habit-app"
SUBMODULE_DIRS[journal]="/home/alpha/vitalos/journal-app"
SUBMODULE_DIRS[learn]="/home/alpha/vitalos/learn-app"
SUBMODULE_DIRS[relax]="/home/alpha/vitalos/relax-app"
SUBMODULE_DIRS[6pack]="/home/alpha/vitalos/6pack-app"
SUBMODULE_DIRS[plan]="/home/alpha/vitalos/plan-app"
SUBMODULE_DIRS[skills]="/home/alpha/vitalos/skills-app"

# skills, plan und 6pack sind seit 2026-10-29 normale Module: fitness-dev trägt sie nicht mehr als
# Gitlinks, der Fitness-Build löst sie über die Nachbar-Checkouts auf (plan-app|plan-dev usw.).
# Ihr Release ist wie bei den anderen dev -> vitalos -> Pointer-Bump im Meta-Repo.

SOURCE_BRANCHES[fitness]="master"
SOURCE_BRANCHES[fuel]="master"
SOURCE_BRANCHES[habits]="master"
SOURCE_BRANCHES[journal]="master"
SOURCE_BRANCHES[learn]="master"
SOURCE_BRANCHES[relax]="master"
SOURCE_BRANCHES[6pack]="master"
SOURCE_BRANCHES[plan]="master"
SOURCE_BRANCHES[skills]="master"

# Submodule-Master-Branch je Modul — alle Module heissen "vitalos" (Rename,
# siehe fitness-dev/CLAUDE.md "Main branch"). journal-app/learn-app standen
# bis 2026-10-13 fälschlich auf "master" ausgecheckt (bzw. gar nicht), obwohl
# .gitmodules schon branch=vitalos deklarierte — war Checkout-Drift, keine
# bewusste Ausnahme (alte Doku hier war falsch). Fallback unten in
# target_branch() falls hier mal ein Modul fehlt.
TARGET_BRANCHES[fitness]="vitalos"
TARGET_BRANCHES[fuel]="vitalos"
TARGET_BRANCHES[habits]="vitalos"
TARGET_BRANCHES[journal]="vitalos"
TARGET_BRANCHES[learn]="vitalos"
TARGET_BRANCHES[relax]="vitalos"
TARGET_BRANCHES[6pack]="vitalos"
TARGET_BRANCHES[plan]="vitalos"
TARGET_BRANCHES[skills]="vitalos"

# vos-release deployt für fitness ausschliesslich npm run build:firebase
# (liest src/** + die KB-*Daten*-YAMLs zur Build-Zeit für die generierten
# src/**/*.generated.js) und pusht dist-firebase/ nach Firebase Hosting.
# Der Python-Code unter fitness/ (fitness/catalog/agent/*.py, fitness/api/*,
# fitness/catalog/cli.py, ...) wird von diesem Build-Pfad nie gelesen — reines
# Katalog-/Backend-Tooling, unabhängig vom vos/Firebase-Release-Zyklus, oft
# mitten in Bearbeitung durch eine parallele Session. kb/inbox/ zusätzlich
# ausgenommen: laufende Drafts vom Enrichment-Watcher, reine Datenchurn.
# node_modules/functions aus demselben Grund wie bei den anderen Modulen.
NOISE_PATTERNS[fitness]='^\?\? (node_modules/.*|functions/node_modules/.*)$|^.{2} fitness/catalog/kb/inbox/|^.{2} fitness/.*\.py$'
NOISE_PATTERNS[fuel]='^(D .+\.bak([.].*)?|D .+\.baks.*|D .+\.mjs\.bak-.*|\?\? (node_modules/.*|functions/node_modules/.*))$'
NOISE_PATTERNS[habits]='^(D .+\.bak([.].*)?|D .+\.baks.*|D .+\.mjs\.bak-.*|\?\? node_modules/.*)$'
NOISE_PATTERNS[journal]='^(D .+\.bak([.].*)?|D .+\.baks.*|D .+\.mjs\.bak-.*|\?\? (node_modules/.*|functions/node_modules/.*))$'
NOISE_PATTERNS[learn]='^(D .+\.bak([.].*)?|D .+\.baks.*|D .+\.mjs\.bak-.*|\?\? node_modules/.*)$'
NOISE_PATTERNS[relax]='^(D .+\.bak([.].*)?|D .+\.baks.*|D .+\.mjs\.bak-.*|\?\? node_modules/.*)$'
NOISE_PATTERNS[6pack]='^(D .+\.bak([.].*)?|D .+\.baks.*|D .+\.mjs\.bak-.*|\?\? node_modules/.*)$'
# coach/plan sind Forks des fitness-dev-Codebase (eigene Apps, gleiches
# Katalog-/Backend-Tooling) — gleiches Noise-Muster wie fitness: Python-
# Backend + kb/inbox-Drafts werden vom Firebase-Build nie gelesen.
NOISE_PATTERNS[plan]='^\?\? (node_modules/.*|functions/node_modules/.*)$|^.{2} fitness/catalog/kb/inbox/|^.{2} fitness/.*\.py$'

# skills-dev: nur Backups/Build-Artefakte sind Rauschen (Hooks unter .claude/ filtert TOOLING_NOISE).
NOISE_PATTERNS[skills]='^\?\? (node_modules/.*|dist/.*)$|^\?\? .*\.bak([.-].*)?$'

# Dokumentation blockiert keinen Release. Die Excludes greifen auch bei
# untracked Dateien in beliebig tiefen Ordnern, da status --untracked-files=all
# Verzeichnisse nicht zu einem einzelnen `?? dir/` zusammenfasst.
DOC_EXCLUDES=(':(exclude,glob)**/*.md' ':(exclude,glob)**/docs/**')

# Firebase-CLI-Cache (entsteht bei jedem firebase deploy) ist nie ein Release-Hindernis;
# in den Repos steht .firebase/ in der .gitignore, aber vor dem Merge fehlt der Eintrag u. U. noch.
CACHE_NOISE='^\?\? (\.firebase/.*|firebase-debug\.log|ui-debug\.log|\.worktrees/.*)$'

# Agent-/Hook-Tooling unter .claude/ (wird parallel von anderen Sessions bearbeitet) ist nie Release-Inhalt.
# Ebenso nie Release-Inhalt (blockiert keinen Release): .gitignore/.gitattributes (Repo-Hygiene, steckt nicht
# in committeten Ständen), Backup-Dateien (*.bak, *.bak-<zeit>), Editor-Reste (*.swp/*.swo), .DS_Store.
TOOLING_NOISE='^.{2} (\.claude/|(.*/)?\.gitignore$|(.*/)?\.gitattributes$|.*\.bak([.-].*)?$|.*\.sw[po]$|(.*/)?\.DS_Store$)'

# Fuel mini-app submodules are stable fallbacks; fuel releases must not bump them.
MODULE_ORDER=(skills fitness fuel habits journal learn relax 6pack plan)
SELECTED_MODULES=()
PARENT_BUMPS=()
DRY_RUN=0
AUTO_YES=0

usage() {
    cat <<'EOF'
vos-release — Shell-Promotion: origin/master der Standalone-Repos nach vitalos mergen, vitalos-Pointer bumpen

Usage:
  vos-release [module ...]
  vos-release --all
  vos-release --dry-run [module ...]
  vos-release --help

Modules:
  skills fitness fuel habits journal learn relax 6pack plan

  skills, plan und 6pack sind eigenständige Module (fitness-dev trägt sie nicht mehr als Gitlinks;
  der Fitness-Build nimmt die Nachbar-Checkouts). Jedes Modul wird einzeln ausgeliefert.

Behavior:
  - Weg: dev -> master (PR, `vos-release-pr <modul>`, deployt Standalone-Prod per CI) -> vitalos (dieses Skript).
  - For every module: fetch origin/master der Standalone-Repos (master existiert lokal nicht), merge it into the
    vitalos branch of the -app checkout, push vitalos.
  - At the end: stage changed submodule pointers in /home/alpha/vitalos,
    create one parent commit, and push vitalos master (deployt die Shell).

Interactive:
  - If no module is given and gum is installed, an interactive multi-select opens.
  - Without gum, you must pass modules explicitly or use --all.

Options:
  --all       Release every known module
  --dry-run   Print what would run, but do not change git state
  --yes       Skip interactive confirmations
  -h, --help  Show this help
EOF
}

info() { echo -e "${BLUE}[INFO]${NC} $*"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $*"; }
success() { echo -e "${GREEN}[OK]${NC} $*"; }
error() { echo -e "${RED}[ERROR]${NC} $*" >&2; }

have_gum() { command -v gum >/dev/null 2>&1; }

run() {
    if [[ "$DRY_RUN" -eq 1 ]]; then
        printf '[dry-run] '
        printf '%q ' "$@"
        printf '\n'
        return 0
    fi
    "$@"
}

confirm() {
    local prompt="$1"
    if [[ "$AUTO_YES" -eq 1 || "$DRY_RUN" -eq 1 ]]; then
        return 0
    fi
    if have_gum; then
        gum confirm "$prompt"
        return $?
    fi
    printf '%s [y/N] ' "$prompt"
    read -r reply
    [[ "${reply,,}" == "y" ]]
}

require_dir() {
    local dir="$1"
    [[ -d "$dir" ]] || { error "Required directory missing: $dir"; exit 1; }
}

module_exists() {
    [[ -n "${STANDALONE_DIRS[$1]:-}" ]]
}

is_doc_path() {
    local path="$1"
    [[ "$path" == *.md || "$path" == docs || "$path" == docs/* || "$path" == */docs || "$path" == */docs/* ]]
}

status_filtered() {
    local module="$1"
    local repo="$2"
    local pattern="${NOISE_PATTERNS[$module]}"
    local status
    status="$("$REAL_GIT" -C "$repo" status --short --untracked-files=all -- . "${DOC_EXCLUDES[@]}" 2>/dev/null || true)"
    if [[ -z "$status" ]]; then
        return 0
    fi
    status="$(printf '%s\n' "$status" | grep -vE "$CACHE_NOISE" | grep -vE "$TOOLING_NOISE" || true)"
    if [[ -z "$status" ]]; then
        return 0
    fi
    if [[ -n "$pattern" && "$pattern" != '^$' ]]; then
        printf '%s\n' "$status" | grep -vE "$pattern" || true
    else
        printf '%s\n' "$status"
    fi
}

require_clean_repo() {
    local module="$1"
    local repo="$2"
    local label="$3"
    local filtered
    filtered="$(status_filtered "$module" "$repo")"
    if [[ -n "$filtered" ]]; then
        error "$label has unexpected changes:"
        printf '%s\n' "$filtered" >&2
        exit 1
    fi
}

expect_branch() {
    local repo="$1"
    local branch_expected="$2"
    local label="$3"
    local branch
    branch="$("$REAL_GIT" -C "$repo" branch --show-current)"
    [[ "$branch" == "$branch_expected" ]] || {
        error "Expected $label on branch $branch_expected, found $branch"
        exit 1
    }
}

select_modules_interactive() {
    if have_gum; then
        mapfile -t SELECTED_MODULES < <(printf "%s\n" "${MODULE_ORDER[@]}" | gum choose --no-limit --header "Select modules to release")
        return
    fi
    error "No modules given and gum is not available. Pass modules explicitly or use --all."
    exit 1
}

resolve_modules() {
    local all=0
    while (($#)); do
        case "$1" in
            --all)
                all=1
                ;;
            --dry-run)
                DRY_RUN=1
                ;;
            --yes)
                AUTO_YES=1
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            *)
                module_exists "$1" || { error "Unknown module: $1"; usage; exit 1; }
                SELECTED_MODULES+=("$1")
                ;;
        esac
        shift
    done

    if [[ "$all" -eq 1 ]]; then
        SELECTED_MODULES=("${MODULE_ORDER[@]}")
    fi

    if [[ "${#SELECTED_MODULES[@]}" -eq 0 ]]; then
        select_modules_interactive
    fi

    normalize_selection
}

# Reihenfolge nach MODULE_ORDER, ohne Duplikate.
normalize_selection() {
    local m wanted=" ${SELECTED_MODULES[*]} "
    SELECTED_MODULES=()
    for m in "${MODULE_ORDER[@]}"; do
        if [[ "$wanted" == *" $m "* ]]; then
            SELECTED_MODULES+=("$m")
        fi
    done
}

ensure_symlinks_if_available() {
    if [[ -x "$ENSURE_LINKS_SCRIPT" ]]; then
        for module in "${SELECTED_MODULES[@]}"; do
            if [[ "$module" == "skills" ]]; then
                continue
            fi
            local standalone_name
            standalone_name="$(basename "${STANDALONE_DIRS[$module]}")"
            run "$ENSURE_LINKS_SCRIPT" "$standalone_name"
        done
    fi
}

resolve_backup_conflicts() {
    local repo="$1"
    local unresolved
    unresolved="$("$REAL_GIT" -C "$repo" diff --name-only --diff-filter=U || true)"
    [[ -n "$unresolved" ]] || return 0

    # Konflikte vorab prüfen, damit wir nie halb gemergt zurückbleiben
    local file
    while IFS= read -r file; do
        [[ -n "$file" ]] || continue
        if [[ ! "$file" =~ \.bak($|[.]) && ! "$file" =~ \.baks && ! "$file" =~ \.mjs\.bak- && ! "$file" =~ ^(\.githooks|\.claude/hooks)/ ]] && ! is_doc_path "$file"; then
            error "Non-backup merge conflict remains in $repo: $file — breche Merge ab (git merge --abort)"
            "$REAL_GIT" -C "$repo" merge --abort || true
            return 1
        fi
    done <<< "$unresolved"

    while IFS= read -r file; do
        [[ -n "$file" ]] || continue
        if is_doc_path "$file"; then
            warn "Doku-Konflikt $file — dev-Stand gewinnt"
            if "$REAL_GIT" -C "$repo" cat-file -e ":3:$file" 2>/dev/null; then
                run "$REAL_GIT" -C "$repo" checkout --theirs -- "$file"
                run "$REAL_GIT" -C "$repo" add -- "$file"
            else
                # Falls dev die Datei gelöscht hat, das Entfernen als dev-Stand übernehmen.
                run "$REAL_GIT" -C "$repo" rm -f -- "$file"
            fi
        elif [[ "$file" =~ ^(\.githooks|\.claude/hooks)/ ]]; then
            # -dev kommt nach -app: bei Hook-Konflikten gewinnt "theirs".
            warn "Hook-Konflikt $file — dev-Stand gewinnt"
            run "$REAL_GIT" -C "$repo" checkout --theirs -- "$file"
            run "$REAL_GIT" -C "$repo" add -- "$file"
        else
            run "$REAL_GIT" -C "$repo" rm -- "$file"
        fi
    done <<< "$unresolved"
}

# Vorab-Check VOR jedem Push: lässt sich lokales dev sauber nach origin/<target> mergen?
# Lesend (git merge-tree). Erlaubte Konflikte: Backup-Dateien, Hooks und Doku (dev gewinnt).
preflight_merge() {
    local module="$1"
    local checkout="${SUBMODULE_DIRS[$module]}"
    local source_branch="${SOURCE_BRANCHES[$module]}"
    local target_branch="${TARGET_BRANCHES[$module]:-master}"
    "$REAL_GIT" -C "$checkout" fetch -q origin "$target_branch" "$source_branch" 2>/dev/null || warn "[$module] fetch origin/$source_branch fehlgeschlagen — Preflight mit altem Stand"
    local out conflicts blocking
    out="$("$REAL_GIT" -C "$checkout" merge-tree --write-tree --name-only --no-messages "origin/$target_branch" "origin/$source_branch" 2>&1 || true)"
    conflicts="$(printf '%s\n' "$out" | tail -n +2 | grep -v '^$' || true)"
    [[ -n "$conflicts" ]] || { info "[$module] Preflight: $source_branch -> $target_branch mergt konfliktfrei"; return 0; }
    blocking=""
    local file
    while IFS= read -r file; do
        [[ -n "$file" ]] || continue
        if [[ "$file" =~ \.bak($|[.]) || "$file" =~ \.baks || "$file" =~ \.mjs\.bak- || "$file" =~ ^(\.githooks|\.claude/hooks)/ ]] || is_doc_path "$file"; then
            continue
        fi
        blocking+="${file}"$'\n'
    done <<< "$conflicts"
    if [[ -n "$blocking" ]]; then
        error "[$module] Preflight: $source_branch -> $target_branch hat Konflikte, die vos-release nicht lösen darf:"
        printf '%s\n' "$blocking" >&2
        return 1
    fi
    warn "[$module] Preflight: nur Hook-/Doku-/Backup-Konflikte ($(printf '%s' "$conflicts" | tr '\n' ' ')) — automatisch behandelt"
}

merge_module() {
    local module="$1"
    local standalone="${STANDALONE_DIRS[$module]}"
    local submodule="${SUBMODULE_DIRS[$module]}"
    local source_branch="${SOURCE_BRANCHES[$module]}"
    local target_branch="${TARGET_BRANCHES[$module]:-master}"
    local submodule_name
    submodule_name="$(basename "$submodule")"

    require_dir "$submodule"

    expect_branch "$submodule" "$target_branch" "$submodule"
    require_clean_repo "$module" "$submodule" "$submodule"

    info "[$module] Pull submodule $target_branch"
    run "$REAL_GIT" -C "$submodule" pull origin "$target_branch"

    # fuel/fitness/habits/journal sind Git-Worktrees EINES Repos (geteilte
    # .git/modules/<name>/worktrees/<name>) — dort existiert der lokale
    # Branch "$source_branch" im Submodule-Checkout automatisch. relax ist
    # (Stand 2026-08-23) ein davon unabhaengiger zweiter Klon desselben
    # Remotes — dort gibt es lokal nur "origin/$source_branch", keinen
    # lokalen Branch gleichen Namens. Frisch fetchen + gegen den
    # Remote-Tracking-Branch mergen funktioniert in beiden Faellen.
    run "$REAL_GIT" -C "$submodule" fetch origin "$source_branch"

    info "[$module] Merge $source_branch into submodule $target_branch"
    if ! run "$REAL_GIT" -C "$submodule" merge "origin/$source_branch" --no-edit; then
        if [[ "$DRY_RUN" -eq 1 ]]; then
            error "Dry-run cannot auto-resolve merge failures for $module"
            exit 1
        fi
        resolve_backup_conflicts "$submodule" || exit 1
        run "$REAL_GIT" -C "$submodule" commit --no-edit
    fi

    info "[$module] Initialize nested submodules before release build/push"
    run "$REAL_GIT" -C "$submodule" submodule sync --recursive
    run "$REAL_GIT" -C "$submodule" submodule update --init --recursive

    info "[$module] Push submodule $target_branch -> origin/$target_branch"
    run "$REAL_GIT" -C "$submodule" push origin "$target_branch"

    PARENT_BUMPS+=("$submodule_name")

}

parent_status_filtered() {
    # Erwartete Zustaende fuer die von vos-release verwalteten Submodule:
    # " M <name>" (Pointer-Bump nach erfolgreichem Push, unstaged) und
    # "?? <name>" (Submodule noch nie initialisiert). Alles andere in
    # /home/alpha/vitalos ist unerwartet und muss vor dem Commit auffallen.
    # Bug bis 2026-08-23: die alte Regex '^ \? (...)$' matchte weder " M"
    # noch "??" und liess JEDEN Pointer-Bump als "unexpected changes"
    # durchfallen — nie aufgefallen, weil der volle Flow vorher nie
    # tatsaechlich per Skript durchlief.
    # Reine Doku-Änderungen (Markdown, docs/) und Firebase-Cache blockieren auch das Meta-Repo nie —
    # der Pointer-Commit läuft mit Pathspec (nur die Submodule), Doku bleibt unangetastet.
    "$REAL_GIT" -C "$VITALOS_DIR" status --short --untracked-files=all -- . "${DOC_EXCLUDES[@]}" 2>/dev/null \
        | grep -vE '^( M|\?\?) (fitness-app|fuel-app|habit-app|journal-app|learn-app|relax-app|6pack-app|plan-app|skills-app)$' \
        | grep -vE "$CACHE_NOISE" | grep -vE "$TOOLING_NOISE" || true
}

# Alle Submodule des Meta-Repos (Pfad relativ zu $VITALOS_DIR); gleiche Liste wie in parent_status_filtered
# und bin/vos-sync-submodule-pointers.
PARENT_SUBMODULES=(fitness-app fuel-app habit-app journal-app learn-app relax-app 6pack-app plan-app skills-app)

# Der pre-commit-Hook (vos-sync-submodule-pointers --stage) stagt beim `commit -- <pathspec>` weitere Pointer.
# Git übernimmt sie in den Commit, lässt im echten Index aber den alten Stand zurück ("MM <submodul>"), und der
# nächste Merge bricht mit "local changes would be overwritten" ab. Nach dem Commit den Index dort an den
# Checkout angleichen, wo der Checkout dem committeten Pointer entspricht (nichts gehört dann mehr zu stagen).
normalize_parent_index() {
    local sub staged head checkout
    for sub in "${PARENT_SUBMODULES[@]}"; do
        [[ -e "$VITALOS_DIR/$sub/.git" ]] || continue
        staged="$("$REAL_GIT" -C "$VITALOS_DIR" ls-files -s -- "$sub" | awk '{print $2}')"
        head="$("$REAL_GIT" -C "$VITALOS_DIR" ls-tree HEAD -- "$sub" | awk '{print $3}')"
        checkout="$("$REAL_GIT" -C "$VITALOS_DIR/$sub" rev-parse HEAD 2>/dev/null || true)"
        if [[ -n "$staged" && "$staged" != "$head" && "$checkout" == "$head" ]]; then
            info "$sub: veraltet gestagten Pointer ${staged:0:7} an Checkout ${head:0:7} angeglichen"
            "$REAL_GIT" -C "$VITALOS_DIR" add -- "$sub"
        fi
    done
}

# Der Remote bekommt zwischendurch eigene Pointer-Bumps (CI, Claude-Web-PRs, z. B. skills-app); ein Push ohne
# vorherigen Merge wird dann als non-fast-forward abgelehnt. Deshalb vor dem Push einmergen.
sync_parent_with_remote() {
    info "Parent: origin/master holen und bei Bedarf einmergen"
    run "$REAL_GIT" -C "$VITALOS_DIR" fetch origin master
    [[ "$DRY_RUN" -eq 1 ]] && { run "$REAL_GIT" -C "$VITALOS_DIR" merge origin/master --no-edit; return 0; }

    local behind
    behind="$("$REAL_GIT" -C "$VITALOS_DIR" rev-list --count HEAD..origin/master)"
    [[ "$behind" -gt 0 ]] || return 0

    info "Parent ist $behind Commit(s) hinter origin/master — merge"
    if ! "$REAL_GIT" -C "$VITALOS_DIR" merge origin/master --no-edit; then
        "$REAL_GIT" -C "$VITALOS_DIR" merge --abort 2>/dev/null || true
        error "Merge von origin/master im Parent fehlgeschlagen (abgebrochen) — nichts gepusht."
        error "Manuell lösen: cd $VITALOS_DIR && git merge origin/master, dann git push origin master."
        exit 1
    fi
}

# Nach einem Pointer-Merge zeigt der Pointer weiter als der Submodul-Checkout (" M <submodul>"). Checkouts stehen
# auf einem Branch, daher Fast-Forward auf den Pointer statt `submodule update` (würde detachen). Nur bei sauberem
# Checkout und wenn der Pointer wirklich ein Nachfolger ist — sonst nur Hinweis.
sync_submodule_checkouts() {
    local sub ptr cur
    for sub in "${PARENT_SUBMODULES[@]}"; do
        [[ -e "$VITALOS_DIR/$sub/.git" ]] || continue
        ptr="$("$REAL_GIT" -C "$VITALOS_DIR" ls-tree HEAD -- "$sub" | awk '{print $3}')"
        cur="$("$REAL_GIT" -C "$VITALOS_DIR/$sub" rev-parse HEAD 2>/dev/null || true)"
        [[ -n "$ptr" && "$ptr" != "$cur" ]] || continue

        if [[ "$DRY_RUN" -eq 1 ]]; then
            printf '[dry-run] %q -C %q merge --ff-only %q (falls %s hinter dem Pointer)\n' "$REAL_GIT" "$VITALOS_DIR/$sub" "$ptr" "$sub"
            continue
        fi
        "$REAL_GIT" -C "$VITALOS_DIR/$sub" fetch -q origin 2>/dev/null || true
        if [[ -n "$("$REAL_GIT" -C "$VITALOS_DIR/$sub" status --porcelain)" ]]; then
            warn "$sub: Checkout hat lokale Änderungen — nicht auf Pointer ${ptr:0:7} gebracht"
        elif "$REAL_GIT" -C "$VITALOS_DIR/$sub" merge-base --is-ancestor "$cur" "$ptr" 2>/dev/null \
            && "$REAL_GIT" -C "$VITALOS_DIR/$sub" merge --ff-only "$ptr" >/dev/null 2>&1; then
            info "$sub: Checkout ${cur:0:7} -> ${ptr:0:7} (fast-forward)"
        else
            warn "$sub: Checkout ${cur:0:7} ist kein Vorgänger von Pointer ${ptr:0:7} — manuell prüfen"
        fi
    done
}

commit_parent_bumps() {
    local filtered
    filtered="$(parent_status_filtered)"
    if [[ -n "$filtered" ]]; then
        # Der Pointer-Commit läuft mit Pathspec nur auf die gebumpten Submodule — fremde/parallele
        # Änderungen im Meta-Repo (z. B. neue Submodule anderer Sessions) bleiben unangetastet.
        warn "$VITALOS_DIR hat fremde Änderungen (werden NICHT mitcommittet):"
        printf '%s\n' "$filtered" >&2
    fi

    local unique=()
    local seen=""
    local item
    for item in "${PARENT_BUMPS[@]}"; do
        if [[ " $seen " != *" $item "* ]]; then
            unique+=("$item")
            seen+=" $item"
        fi
    done

    [[ "${#unique[@]}" -gt 0 ]] || { warn "No submodule bumps collected"; return 0; }

    info "Staging parent submodule pointers"
    run "$REAL_GIT" -C "$VITALOS_DIR" add "${unique[@]}"

    local joined
    joined="$(IFS=', '; echo "${SELECTED_MODULES[*]}")"
    local message="chore(submodules): bump ${joined} after release"

    if [[ "$DRY_RUN" -eq 1 ]]; then
        printf '[dry-run] %q ' "$REAL_GIT" -C "$VITALOS_DIR" commit -m "$message" -- "${unique[@]}"
        printf '\n'
        sync_parent_with_remote
        printf '[dry-run] %q ' "$REAL_GIT" -C "$VITALOS_DIR" push origin master
        printf '\n'
        sync_submodule_checkouts
        return 0
    fi

    if "$REAL_GIT" -C "$VITALOS_DIR" diff --cached --quiet -- "${unique[@]}"; then
        warn "No parent submodule pointer changes detected"
    else
        "$REAL_GIT" -C "$VITALOS_DIR" commit -m "$message" -- "${unique[@]}"
    fi
    normalize_parent_index

    sync_parent_with_remote

    info "Pushing vitalos master -> origin/master"
    run "$REAL_GIT" -C "$VITALOS_DIR" push origin master

    sync_submodule_checkouts
}

# CI installiert mit --frozen-lockfile: weicht pnpm-lock.yaml von den package.json der (gerade
# gemergten) Submodule ab, scheitern alle Deploy-Workflows. Deshalb vor dem Master-Push prüfen.
check_lockfile() {
    [[ "$DRY_RUN" -eq 1 ]] && return 0
    command -v pnpm >/dev/null 2>&1 || { warn "pnpm fehlt — Lockfile-Check übersprungen"; return 0; }
    if ! (cd "$VITALOS_DIR" && pnpm install --frozen-lockfile --lockfile-only >/dev/null 2>&1); then
        error "pnpm-lock.yaml passt nicht zu den package.json der Module — master wird NICHT gepusht."
        error "Beheben: cd $VITALOS_DIR && pnpm install --no-frozen-lockfile && git add pnpm-lock.yaml && git commit, dann Release erneut."
        exit 1
    fi
    info "Lockfile-Check: pnpm-lock.yaml ist aktuell"
    # Der Check läuft gegen den Arbeitsbaum. Hat pnpm das Lockfile dabei (oder zuvor) geändert, ist es
    # grün, obwohl das gepushte Lockfile veraltet wäre — genau das hat am 2026-10-29 sechs Deploys
    # (frozen-lockfile, fuel-app pino) rot gemacht. Deshalb die Änderung mitcommitten.
    if ! "$REAL_GIT" -C "$VITALOS_DIR" diff --quiet -- pnpm-lock.yaml; then
        info "pnpm-lock.yaml hat uncommittete Änderungen — wird mitcommittet"
        run "$REAL_GIT" -C "$VITALOS_DIR" add pnpm-lock.yaml
        run "$REAL_GIT" -C "$VITALOS_DIR" commit -m "fix(lock): pnpm-lock.yaml an die Modul-package.json angepasst (vos-release)" -- pnpm-lock.yaml
    fi
}

main() {
    resolve_modules "$@"
    require_dir "$VITALOS_DIR"
    expect_branch "$VITALOS_DIR" "master" "$VITALOS_DIR"

    if [[ "${#SELECTED_MODULES[@]}" -eq 0 ]]; then
        error "No modules selected"
        exit 1
    fi

    info "Selected modules: ${SELECTED_MODULES[*]}"
    confirm "Run release flow for: ${SELECTED_MODULES[*]}?" || {
        warn "Aborted."
        exit 1
    }

    ensure_symlinks_if_available

    local module pre_fail=0
    for module in "${SELECTED_MODULES[@]}"; do
        preflight_merge "$module" || pre_fail=1
    done
    [[ "$pre_fail" -eq 0 ]] || { error "Preflight fehlgeschlagen — nichts wurde gepusht."; exit 1; }

    for module in "${SELECTED_MODULES[@]}"; do
        merge_module "$module"
    done

    check_lockfile
    commit_parent_bumps
    success "vos release flow complete"
}

main "$@"
