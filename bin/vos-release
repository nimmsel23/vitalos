#!/usr/bin/env bash
set -euo pipefail

REAL_GIT="/usr/bin/git"
VITALOS_DIR="/home/alpha/vitalos"
ENSURE_LINKS_SCRIPT="$VITALOS_DIR/bin/ensure-node-modules-symlinks.sh"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
NC='\033[0m'

declare -A STANDALONE_DIRS
declare -A SUBMODULE_DIRS
declare -A SOURCE_BRANCHES
declare -A TARGET_BRANCHES
declare -A NOISE_PATTERNS

STANDALONE_DIRS[fitness]="/home/alpha/fitness-dev"
STANDALONE_DIRS[fuel]="/home/alpha/fuel-dev"
STANDALONE_DIRS[habits]="/home/alpha/habits-dev"
STANDALONE_DIRS[journal]="/home/alpha/journal-dev"
STANDALONE_DIRS[learn]="/home/alpha/learn-dev"
STANDALONE_DIRS[relax]="/home/alpha/relax-dev"
STANDALONE_DIRS[6pack]="/home/alpha/6pack-dev"
STANDALONE_DIRS[coach]="/home/alpha/coach-dev"
STANDALONE_DIRS[plan]="/home/alpha/plan-dev"

SUBMODULE_DIRS[fitness]="/home/alpha/vitalos/fitness-app"
SUBMODULE_DIRS[fuel]="/home/alpha/vitalos/fuel-app"
SUBMODULE_DIRS[habits]="/home/alpha/vitalos/habit-app"
SUBMODULE_DIRS[journal]="/home/alpha/vitalos/journal-app"
SUBMODULE_DIRS[learn]="/home/alpha/vitalos/learn-app"
SUBMODULE_DIRS[relax]="/home/alpha/vitalos/relax-app"
SUBMODULE_DIRS[6pack]="/home/alpha/vitalos/6pack-app"
SUBMODULE_DIRS[coach]="/home/alpha/vitalos/coach-app"
SUBMODULE_DIRS[plan]="/home/alpha/vitalos/plan-app"

SOURCE_BRANCHES[fitness]="dev"
SOURCE_BRANCHES[fuel]="dev"
SOURCE_BRANCHES[habits]="dev"
SOURCE_BRANCHES[journal]="dev"
SOURCE_BRANCHES[learn]="dev"
SOURCE_BRANCHES[relax]="dev"
SOURCE_BRANCHES[6pack]="dev"
SOURCE_BRANCHES[coach]="dev"
SOURCE_BRANCHES[plan]="dev"

# Submodule-Master-Branch je Modul — alle Module heissen "vitalos" (Rename,
# siehe fitness-dev/CLAUDE.md "Main branch"). journal-app/learn-app standen
# bis 2026-10-13 fälschlich auf "master" ausgecheckt (bzw. gar nicht), obwohl
# .gitmodules schon branch=vitalos deklarierte — war Checkout-Drift, keine
# bewusste Ausnahme (alte Doku hier war falsch). Fallback unten in
# target_branch() falls hier mal ein Modul fehlt.
TARGET_BRANCHES[fitness]="vitalos"
TARGET_BRANCHES[fuel]="vitalos"
TARGET_BRANCHES[habits]="vitalos"
TARGET_BRANCHES[journal]="vitalos"
TARGET_BRANCHES[learn]="vitalos"
TARGET_BRANCHES[relax]="vitalos"
TARGET_BRANCHES[6pack]="vitalos"
TARGET_BRANCHES[coach]="vitalos"
TARGET_BRANCHES[plan]="vitalos"

# vos-release deployt für fitness ausschliesslich npm run build:firebase
# (liest src/** + die KB-*Daten*-YAMLs zur Build-Zeit für die generierten
# src/**/*.generated.js) und pusht dist-firebase/ nach Firebase Hosting.
# Der Python-Code unter fitness/ (fitness/catalog/agent/*.py, fitness/api/*,
# fitness/catalog/cli.py, ...) wird von diesem Build-Pfad nie gelesen — reines
# Katalog-/Backend-Tooling, unabhängig vom vos/Firebase-Release-Zyklus, oft
# mitten in Bearbeitung durch eine parallele Session. kb/inbox/ zusätzlich
# ausgenommen: laufende Drafts vom Enrichment-Watcher, reine Datenchurn.
# node_modules/functions aus demselben Grund wie bei den anderen Modulen.
NOISE_PATTERNS[fitness]='^\?\? (node_modules|functions/node_modules)$|^.{2} fitness/catalog/kb/inbox/|^.{2} fitness/.*\.py$'
NOISE_PATTERNS[fuel]='^(D .+\.bak([.].*)?|D .+\.baks.*|D .+\.mjs\.bak-.*|\?\? (node_modules|functions/node_modules))$'
NOISE_PATTERNS[habits]='^(D .+\.bak([.].*)?|D .+\.baks.*|D .+\.mjs\.bak-.*|\?\? node_modules)$'
NOISE_PATTERNS[journal]='^(D .+\.bak([.].*)?|D .+\.baks.*|D .+\.mjs\.bak-.*|\?\? (node_modules|functions/node_modules))$'
NOISE_PATTERNS[learn]='^(D .+\.bak([.].*)?|D .+\.baks.*|D .+\.mjs\.bak-.*|\?\? node_modules)$'
NOISE_PATTERNS[relax]='^(D .+\.bak([.].*)?|D .+\.baks.*|D .+\.mjs\.bak-.*|\?\? node_modules)$'
NOISE_PATTERNS[6pack]='^(D .+\.bak([.].*)?|D .+\.baks.*|D .+\.mjs\.bak-.*|\?\? node_modules)$'
# coach/plan sind Forks des fitness-dev-Codebase (eigene Apps, gleiches
# Katalog-/Backend-Tooling) — gleiches Noise-Muster wie fitness: Python-
# Backend + kb/inbox-Drafts werden vom Firebase-Build nie gelesen.
NOISE_PATTERNS[coach]='^\?\? (node_modules|functions/node_modules)$|^.{2} fitness/catalog/kb/inbox/|^.{2} fitness/.*\.py$'
NOISE_PATTERNS[plan]='^\?\? (node_modules|functions/node_modules)$|^.{2} fitness/catalog/kb/inbox/|^.{2} fitness/.*\.py$'

# Reine Doku-Änderungen (Markdown, docs/) blockieren nie einen Release —
# NEXT.md/RESULTS.md/TODO.md werden laufend von Hooks/Sessions nachgepflegt
# und fließen nicht in Build/Deploy ein. Gilt für alle Module.
DOC_NOISE='^.{2} (docs/.*|.*\.md)$'

# Firebase-CLI-Cache (entsteht bei jedem firebase deploy) ist nie ein Release-Hindernis;
# in den Repos steht .firebase/ in der .gitignore, aber vor dem Merge fehlt der Eintrag u. U. noch.
CACHE_NOISE='^\?\? (\.firebase/|firebase-debug\.log|ui-debug\.log|\.worktrees/)$'

# Agent-/Hook-Tooling unter .claude/ (wird parallel von anderen Sessions bearbeitet) ist nie Release-Inhalt
TOOLING_NOISE='^.{2} \.claude/'

MODULE_ORDER=(fitness fuel habits journal learn relax 6pack coach plan)
SELECTED_MODULES=()
PARENT_BUMPS=()
DRY_RUN=0
AUTO_YES=0

usage() {
    cat <<EOF
vos-release — push standalone repos, merge into vitalos submodule masters, bump vitalos pointers

Usage:
  vos-release [module ...]
  vos-release --all
  vos-release --dry-run [module ...]
  vos-release --help

Modules:
  fitness fuel habits journal learn relax 6pack coach plan

Behavior:
  - For every module: push standalone dev -> origin/dev, merge dev into the
    corresponding vitalos submodule master (or "vitalos" for fitness), push.
  - At the end: stage changed submodule pointers in /home/alpha/vitalos,
    create one parent commit, and push vitalos master.

Interactive:
  - If no module is given and gum is installed, an interactive multi-select opens.
  - Without gum, you must pass modules explicitly or use --all.

Options:
  --all       Release every known module
  --dry-run   Print what would run, but do not change git state
  --yes       Skip interactive confirmations
  -h, --help  Show this help
EOF
}

info() { echo -e "${BLUE}[INFO]${NC} $*"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $*"; }
success() { echo -e "${GREEN}[OK]${NC} $*"; }
error() { echo -e "${RED}[ERROR]${NC} $*" >&2; }

have_gum() { command -v gum >/dev/null 2>&1; }

run() {
    if [[ "$DRY_RUN" -eq 1 ]]; then
        printf '[dry-run] '
        printf '%q ' "$@"
        printf '\n'
        return 0
    fi
    "$@"
}

confirm() {
    local prompt="$1"
    if [[ "$AUTO_YES" -eq 1 || "$DRY_RUN" -eq 1 ]]; then
        return 0
    fi
    if have_gum; then
        gum confirm "$prompt"
        return $?
    fi
    printf '%s [y/N] ' "$prompt"
    read -r reply
    [[ "${reply,,}" == "y" ]]
}

require_dir() {
    local dir="$1"
    [[ -d "$dir" ]] || { error "Required directory missing: $dir"; exit 1; }
}

module_exists() {
    [[ -n "${STANDALONE_DIRS[$1]:-}" ]]
}

status_filtered() {
    local module="$1"
    local repo="$2"
    local pattern="${NOISE_PATTERNS[$module]}"
    local status
    status="$("$REAL_GIT" -C "$repo" status --short 2>/dev/null || true)"
    if [[ -z "$status" ]]; then
        return 0
    fi
    status="$(printf '%s\n' "$status" | grep -vE "$DOC_NOISE" | grep -vE "$CACHE_NOISE" | grep -vE "$TOOLING_NOISE" || true)"
    if [[ -z "$status" ]]; then
        return 0
    fi
    if [[ -n "$pattern" && "$pattern" != '^$' ]]; then
        printf '%s\n' "$status" | grep -vE "$pattern" || true
    else
        printf '%s\n' "$status"
    fi
}

require_clean_repo() {
    local module="$1"
    local repo="$2"
    local label="$3"
    local filtered
    filtered="$(status_filtered "$module" "$repo")"
    if [[ -n "$filtered" ]]; then
        error "$label has unexpected changes:"
        printf '%s\n' "$filtered" >&2
        exit 1
    fi
}

expect_branch() {
    local repo="$1"
    local branch_expected="$2"
    local label="$3"
    local branch
    branch="$("$REAL_GIT" -C "$repo" branch --show-current)"
    [[ "$branch" == "$branch_expected" ]] || {
        error "Expected $label on branch $branch_expected, found $branch"
        exit 1
    }
}

select_modules_interactive() {
    if have_gum; then
        mapfile -t SELECTED_MODULES < <(printf '%s\n' "${MODULE_ORDER[@]}" | gum choose --no-limit --header "Select modules to release")
        return
    fi
    error "No modules given and gum is not available. Pass modules explicitly or use --all."
    exit 1
}

resolve_modules() {
    local all=0
    while (($#)); do
        case "$1" in
            --all)
                all=1
                ;;
            --dry-run)
                DRY_RUN=1
                ;;
            --yes)
                AUTO_YES=1
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            *)
                module_exists "$1" || { error "Unknown module: $1"; usage; exit 1; }
                SELECTED_MODULES+=("$1")
                ;;
        esac
        shift
    done

    if [[ "$all" -eq 1 ]]; then
        SELECTED_MODULES=("${MODULE_ORDER[@]}")
    fi

    if [[ "${#SELECTED_MODULES[@]}" -eq 0 ]]; then
        select_modules_interactive
    fi
}

ensure_symlinks_if_available() {
    if [[ -x "$ENSURE_LINKS_SCRIPT" ]]; then
        for module in "${SELECTED_MODULES[@]}"; do
            local standalone_name
            standalone_name="$(basename "${STANDALONE_DIRS[$module]}")"
            run "$ENSURE_LINKS_SCRIPT" "$standalone_name"
        done
    fi
}

resolve_backup_conflicts() {
    local repo="$1"
    local unresolved
    unresolved="$("$REAL_GIT" -C "$repo" diff --name-only --diff-filter=U || true)"
    [[ -n "$unresolved" ]] || return 0

    # Konflikte vorab prüfen, damit wir nie halb gemergt zurückbleiben
    local file
    while IFS= read -r file; do
        [[ -n "$file" ]] || continue
        if [[ ! "$file" =~ \.bak($|[.]) && ! "$file" =~ \.baks && ! "$file" =~ \.mjs\.bak- && ! "$file" =~ ^(\.githooks|\.claude/hooks)/ ]]; then
            error "Non-backup merge conflict remains in $repo: $file — breche Merge ab (git merge --abort)"
            "$REAL_GIT" -C "$repo" merge --abort || true
            return 1
        fi
    done <<< "$unresolved"

    while IFS= read -r file; do
        [[ -n "$file" ]] || continue
        if [[ "$file" =~ ^(\.githooks|\.claude/hooks)/ ]]; then
            # -dev kommt nach -app: bei Hook-Konflikten gewinnt der gemergte dev-Stand ("theirs")
            warn "Hook-Konflikt $file — dev-Stand gewinnt"
            run "$REAL_GIT" -C "$repo" checkout --theirs -- "$file"
            run "$REAL_GIT" -C "$repo" add -- "$file"
        else
            run "$REAL_GIT" -C "$repo" rm -- "$file"
        fi
    done <<< "$unresolved"
}

# Vorab-Check VOR jedem Push: lässt sich lokales dev sauber nach origin/<target> mergen?
# Lesend (git merge-tree). Erlaubte Konflikte: Backup-Dateien und .githooks/* (dev gewinnt).
preflight_merge() {
    local module="$1"
    local standalone="${STANDALONE_DIRS[$module]}"
    local source_branch="${SOURCE_BRANCHES[$module]}"
    local target_branch="${TARGET_BRANCHES[$module]:-master}"
    "$REAL_GIT" -C "$standalone" fetch -q origin "$target_branch" 2>/dev/null || warn "[$module] fetch origin/$target_branch fehlgeschlagen — Preflight mit altem Stand"
    local out conflicts blocking
    out="$("$REAL_GIT" -C "$standalone" merge-tree --write-tree --name-only --no-messages "origin/$target_branch" "$source_branch" 2>&1 || true)"
    conflicts="$(printf '%s\n' "$out" | tail -n +2 | grep -v '^$' || true)"
    [[ -n "$conflicts" ]] || { info "[$module] Preflight: dev -> $target_branch mergt konfliktfrei"; return 0; }
    blocking="$(printf '%s\n' "$conflicts" | grep -vE '\.bak($|[.])|\.baks|\.mjs\.bak-|^(\.githooks|\.claude/hooks)/' || true)"
    if [[ -n "$blocking" ]]; then
        error "[$module] Preflight: dev -> $target_branch hat Konflikte, die vos-release nicht lösen darf:"
        printf '%s\n' "$blocking" >&2
        return 1
    fi
    warn "[$module] Preflight: nur Hook-/Backup-Konflikte ($(printf '%s' "$conflicts" | tr '\n' ' ')) — dev gewinnt"
}

merge_module() {
    local module="$1"
    local standalone="${STANDALONE_DIRS[$module]}"
    local submodule="${SUBMODULE_DIRS[$module]}"
    local source_branch="${SOURCE_BRANCHES[$module]}"
    local target_branch="${TARGET_BRANCHES[$module]:-master}"
    local submodule_name
    submodule_name="$(basename "$submodule")"

    require_dir "$standalone"
    require_dir "$submodule"

    expect_branch "$standalone" "$source_branch" "$standalone"
    expect_branch "$submodule" "$target_branch" "$submodule"
    require_clean_repo "$module" "$standalone" "$standalone"
    require_clean_repo "$module" "$submodule" "$submodule"

    info "[$module] Push $source_branch -> origin/$source_branch"
    run "$REAL_GIT" -C "$standalone" push origin "$source_branch"

    info "[$module] Pull submodule $target_branch"
    run "$REAL_GIT" -C "$submodule" pull origin "$target_branch"

    # fuel/fitness/habits/journal sind Git-Worktrees EINES Repos (geteilte
    # .git/modules/<name>/worktrees/<name>) — dort existiert der lokale
    # Branch "$source_branch" im Submodule-Checkout automatisch. relax ist
    # (Stand 2026-08-23) ein davon unabhaengiger zweiter Klon desselben
    # Remotes — dort gibt es lokal nur "origin/$source_branch", keinen
    # lokalen Branch gleichen Namens. Frisch fetchen + gegen den
    # Remote-Tracking-Branch mergen funktioniert in beiden Faellen.
    run "$REAL_GIT" -C "$submodule" fetch origin "$source_branch"

    info "[$module] Merge $source_branch into submodule $target_branch"
    if ! run "$REAL_GIT" -C "$submodule" merge "origin/$source_branch" --no-edit; then
        if [[ "$DRY_RUN" -eq 1 ]]; then
            error "Dry-run cannot auto-resolve merge failures for $module"
            exit 1
        fi
        resolve_backup_conflicts "$submodule" || exit 1
        run "$REAL_GIT" -C "$submodule" commit --no-edit
    fi

    info "[$module] Initialize nested submodules before release build/push"
    run "$REAL_GIT" -C "$submodule" submodule sync --recursive
    run "$REAL_GIT" -C "$submodule" submodule update --init --recursive

    info "[$module] Push submodule $target_branch -> origin/$target_branch"
    run "$REAL_GIT" -C "$submodule" push origin "$target_branch"

    PARENT_BUMPS+=("$submodule_name")
}

parent_status_filtered() {
    # Erwartete Zustaende fuer die von vos-release verwalteten Submodule:
    # " M <name>" (Pointer-Bump nach erfolgreichem Push, unstaged) und
    # "?? <name>" (Submodule noch nie initialisiert). Alles andere in
    # /home/alpha/vitalos ist unerwartet und muss vor dem Commit auffallen.
    # Bug bis 2026-08-23: die alte Regex '^ \? (...)$' matchte weder " M"
    # noch "??" und liess JEDEN Pointer-Bump als "unexpected changes"
    # durchfallen — nie aufgefallen, weil der volle Flow vorher nie
    # tatsaechlich per Skript durchlief.
    # Reine Doku-Änderungen (Markdown, docs/) und Firebase-Cache blockieren auch das Meta-Repo nie —
    # der Pointer-Commit läuft mit Pathspec (nur die Submodule), Doku bleibt unangetastet.
    "$REAL_GIT" -C "$VITALOS_DIR" status --short 2>/dev/null \
        | grep -vE '^( M|\?\?) (fitness-app|fuel-app|habit-app|journal-app|learn-app|relax-app|6pack-app|plan-app|coach-app)$' \
        | grep -vE "$DOC_NOISE" | grep -vE "$CACHE_NOISE" | grep -vE "$TOOLING_NOISE" || true
}

commit_parent_bumps() {
    local filtered
    filtered="$(parent_status_filtered)"
    if [[ -n "$filtered" ]]; then
        # Der Pointer-Commit läuft mit Pathspec nur auf die gebumpten Submodule — fremde/parallele
        # Änderungen im Meta-Repo (z. B. neue Submodule anderer Sessions) bleiben unangetastet.
        warn "$VITALOS_DIR hat fremde Änderungen (werden NICHT mitcommittet):"
        printf '%s\n' "$filtered" >&2
    fi

    local unique=()
    local seen=""
    local item
    for item in "${PARENT_BUMPS[@]}"; do
        if [[ " $seen " != *" $item "* ]]; then
            unique+=("$item")
            seen+=" $item"
        fi
    done

    [[ "${#unique[@]}" -gt 0 ]] || { warn "No submodule bumps collected"; return 0; }

    info "Staging parent submodule pointers"
    run "$REAL_GIT" -C "$VITALOS_DIR" add "${unique[@]}"

    local joined
    joined="$(IFS=', '; echo "${SELECTED_MODULES[*]}")"
    local message="chore(submodules): bump ${joined} after release"

    if [[ "$DRY_RUN" -eq 1 ]]; then
        printf '[dry-run] %q ' "$REAL_GIT" -C "$VITALOS_DIR" commit -m "$message" -- "${unique[@]}"
        printf '\n'
        printf '[dry-run] %q ' "$REAL_GIT" -C "$VITALOS_DIR" push origin master
        printf '\n'
        return 0
    fi

    if "$REAL_GIT" -C "$VITALOS_DIR" diff --cached --quiet -- "${unique[@]}"; then
        warn "No parent submodule pointer changes detected"
    else
        "$REAL_GIT" -C "$VITALOS_DIR" commit -m "$message" -- "${unique[@]}"
    fi

    info "Pushing vitalos master -> origin/master"
    run "$REAL_GIT" -C "$VITALOS_DIR" push origin master
}

main() {
    resolve_modules "$@"
    require_dir "$VITALOS_DIR"
    expect_branch "$VITALOS_DIR" "master" "$VITALOS_DIR"

    if [[ "${#SELECTED_MODULES[@]}" -eq 0 ]]; then
        error "No modules selected"
        exit 1
    fi

    info "Selected modules: ${SELECTED_MODULES[*]}"
    confirm "Run release flow for: ${SELECTED_MODULES[*]}?" || {
        warn "Aborted."
        exit 1
    }

    ensure_symlinks_if_available

    local module pre_fail=0
    for module in "${SELECTED_MODULES[@]}"; do
        preflight_merge "$module" || pre_fail=1
    done
    [[ "$pre_fail" -eq 0 ]] || { error "Preflight fehlgeschlagen — nichts wurde gepusht."; exit 1; }

    for module in "${SELECTED_MODULES[@]}"; do
        merge_module "$module"
    done

    commit_parent_bumps
    success "vos release flow complete"
}

main "$@"
