#!/usr/bin/env bash
# vos-ship — Standalone-Live auf master prüfen, dann Shell-Pin (vos-release) in EINEM Lauf.
#
#   vos-ship fitness                interaktiv
#   vos-ship coach --yes           Standalone-Coach-CI + Live-SHA prüfen (kein Shell-Build)
#   vos-ship fitness --yes          ohne Rückfragen (nur nach ausdrücklicher Freigabe!)
#   vos-ship journal --functions    Zusätzlich die Journal-Push-Function deployen
#   vos-ship fitness --dry-run      Preflight + Plan, ändert nichts (ruft vos-release --dry-run)
#
# Ablauf (seit 2026-11-09 — kein master→vitalos-PR mehr):
#   1. Preflight   origin/master erreichbar? Pin hinter Tip?
#   2. Live-Deploy auf den Standalone-Deploy der CI warten (falls Run existiert)
#   3. Shell-Pin   vos-release <modul>: *-app auf origin/master, Pointer, Meta-Push
#   4. Nachlauf    Live-Deploy bei Lockfile-Fail neu starten; optional --functions
#
# Standalone-Promotion bleibt dev→master (Auto-Promote / vos-release-pr). Dieses Skript
# ist nur das Shell-Adoptions-Gate (Pointer-Bump).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Modul -> Repo | lokaler Klon (identisch zu vos-release-pr)
declare -A CFG=(
  [coach]="nimmsel23/coach-dev|$HOME/dev/coach-dev"
  [fitness]="nimmsel23/fitness-dev|$HOME/dev/fitness-dev"
  [fuel]="nimmsel23/fuel-dev|$HOME/dev/fuel-dev"
  [habits]="nimmsel23/habits-dev|$HOME/dev/habits-dev"
  [journal]="nimmsel23/journal-dev|$HOME/dev/journal-dev"
  [learn]="nimmsel23/learn-dev|$HOME/dev/learn-dev"
  [relax]="nimmsel23/relax-dev|$HOME/dev/relax-dev"
  [plan]="nimmsel23/plan-dev|$HOME/dev/plan-dev"
  [6pack]="nimmsel23/6pack-dev|$HOME/dev/6pack-dev"
  [skills]="nimmsel23/skills-dev|$HOME/dev/skills-dev"
)

CHECK_TIMEOUT=1200     # Sekunden für CI-Checks
MERGE_WAIT=300         # Sekunden auf den Auto-Merge
DEPLOY_APPEAR_WAIT=180 # Sekunden, bis der Live-Deploy-Run erscheint
DEPLOY_TIMEOUT=900     # Sekunden für den Live-Deploy-Run

info() { printf '[vos-ship] %s\n' "$*"; }
step() { printf '\n[vos-ship] ── %s\n' "$*"; }
die()  { printf '[vos-ship] FEHLER: %s\n' "$*" >&2; exit 1; }

module=""; YES=0; DRY=0; FUNCTIONS=0
for arg in "$@"; do
  case "$arg" in
    --yes) YES=1 ;;
    --dry-run) DRY=1 ;;
    --functions) FUNCTIONS=1 ;;
    -h|--help) sed -n 2,24p "${BASH_SOURCE[0]}"; exit 0 ;;
    -*) die "unbekannte Option: $arg" ;;
    *) [[ -z "$module" ]] && module="$arg" || die "nur ein Modul pro Lauf" ;;
  esac
done
[[ -n "$module" && -n "${CFG[$module]:-}" ]] || die "Modul angeben: ${!CFG[*]}"
if [[ "$FUNCTIONS" -eq 1 && "$module" != "journal" && "$module" != "fitness" ]]; then
  die "--functions wird derzeit für journal und fitness unterstützt"
fi
IFS='|' read -r repo dir <<<"${CFG[$module]}"
[[ -d "$dir/.git" || -f "$dir/.git" ]] || die "Klon fehlt: $dir"
if [[ "$module" == coach ]]; then
  args=()
  [[ "$YES" -eq 0 ]] || args+=(--yes)
  [[ "$DRY" -eq 0 ]] || args+=(--dry-run)
  exec "$dir/bin/coach-release" "${args[@]}"
fi
for tool in gh jq git; do command -v "$tool" >/dev/null || die "$tool fehlt"; done

LIVE_BRANCH=master
RELEASE_ARGS=(); YES_HINT=""
if [[ "$YES" -eq 1 ]]; then RELEASE_ARGS+=(--yes); YES_HINT=" --yes"; fi

# ── 1. Preflight ───────────────────────────────────────────────────────────────
step "1/4 Preflight ($module: origin/master → Shell-Pin)"
git -C "$dir" fetch -q origin master
master_sha="$(git -C "$dir" rev-parse origin/master)"
info "origin/master=${master_sha:0:7}"

case "$module" in
  habits) app_dir="$HOME/vitalos/habit-app" ;;
  6pack) app_dir="$HOME/vitalos/6pack-app" ;;
  *) app_dir="$HOME/vitalos/${module}-app" ;;
esac
if [[ -e "$app_dir/.git" || -f "$app_dir/.git" ]]; then
  pin_sha="$(git -C "$app_dir" rev-parse HEAD 2>/dev/null || true)"
  if [[ -n "$pin_sha" && "$pin_sha" == "$master_sha" ]]; then
    info "Shell-Pin ist schon origin/master"
  elif [[ -n "$pin_sha" ]]; then
    ahead="$(git -C "$dir" rev-list --count "${pin_sha}..${master_sha}" 2>/dev/null || echo "?")"
    info "Shell-Pin ${pin_sha:0:7} → master ${master_sha:0:7} (delta $ahead)"
  fi
fi

if [[ "$DRY" -eq 1 ]]; then
  suffix=""
  [[ "$FUNCTIONS" -eq 0 ]] || suffix=" und Push-Function deployen"
  info "dry-run: würde Live-Deploy abwarten und vos-release $module ausführen$suffix."
  step "3/4 vos-release --dry-run $module"
  exec "$SCRIPT_DIR/vos-release" --dry-run "$module"
fi

if [[ "$YES" -ne 1 ]]; then
  printf '[vos-ship] Shell-Pin auf origin/master (%s) setzen und Meta pushen? [j/N] ' "${master_sha:0:7}"
  read -r reply
  [[ "$reply" =~ ^[jJyY]$ ]] || die "abgebrochen"
fi

# ── 2. Live-Deploy ─────────────────────────────────────────────────────────────
LIVE_FAILED_LOCK=0
LIVE_WORKFLOW=""
if :; then
  step "2/4 Live-Deploy der CI (Push auf $LIVE_BRANCH, Commit ${master_sha:0:7})"
  run_id=""; waited=0
  while [[ -z "$run_id" ]]; do
    run_id="$(gh run list -R "$repo" --branch "$LIVE_BRANCH" --limit 20 --json databaseId,name,headSha,createdAt \
      --jq "[.[] | select((.name | test(\"Live Deploy|deploy\"; \"i\")) and .headSha == \"$master_sha\")] | sort_by(.createdAt) | last | .databaseId // empty")"
    [[ -n "$run_id" ]] && break
    (( waited >= DEPLOY_APPEAR_WAIT )) && { info "kein Live-Deploy-Run erschienen (nach ${DEPLOY_APPEAR_WAIT}s) — weiter mit Shell-Pin"; break; }
    sleep 10; waited=$((waited + 10))
  done
  if [[ -n "$run_id" ]]; then
    LIVE_WORKFLOW="$(gh run view "$run_id" -R "$repo" --json name --jq .name)"
    info "Run $run_id: $LIVE_WORKFLOW"
    if "$SCRIPT_DIR/gh-run-check" --repo "$repo" --timeout "$DEPLOY_TIMEOUT" "$run_id"; then
      info "Live-Deploy erfolgreich"
    else
      if gh run view "$run_id" -R "$repo" --log-failed 2>/dev/null | grep -q 'ERR_PNPM_OUTDATED_LOCKFILE'; then
        LIVE_FAILED_LOCK=1
        info "Live-Deploy scheiterte am Lockfile (ERR_PNPM_OUTDATED_LOCKFILE) — der Root-Lockfile im Meta-Repo wird erst im nächsten Schritt nachgezogen; danach wird neu gestartet."
      else
        die "Live-Deploy fehlgeschlagen (kein Lockfile-Problem): gh run view $run_id -R $repo --log-failed"
      fi
    fi
  fi
fi

# ── 3. Shell-Pin ────────────────────────────────────────────────────────────────
# Lockfile des Meta-Repos (Option B, "Lite"): vos-release prüft vor dem Master-Push, ob
# pnpm-lock.yaml zu den package.json der Module passt, und bricht sonst ab. Hier wird der
# Lockfile dann automatisch nachgezogen (nur pnpm-lock.yaml, Pathspec-Commit) und vos-release
# wiederholt — Lockfile UND Pointer gehen so in EINEM Push raus. Das ist Absicht: deploy-shell.yml
# und deploy-vos-fitness.yml laufen bei jedem Push auf Meta-master mit --frozen-lockfile gegen
# die gepinnten Submodule; ein früher gepushter Lockfile würde dort rot werden, solange der
# Pointer noch auf das alte Modul zeigt.
step "3/4 vos-release $module (Pin origin/master, Meta-Repo)"
release_log="$(mktemp)"; trap 'rm -f "$release_log"' EXIT
run_release() {
  set +e
  "$SCRIPT_DIR/vos-release" "${RELEASE_ARGS[@]}" "$module" 2>&1 | tee "$release_log"
  local rc=${PIPESTATUS[0]}
  set -e
  return "$rc"
}
if ! run_release; then
  if grep -q 'pnpm-lock.yaml passt nicht zu den package.json' "$release_log"; then
    info "Lockfile im Meta-Repo veraltet — ziehe ihn nach (pnpm install --lockfile-only) und wiederhole vos-release"
    ( cd "$HOME/vitalos"
      pnpm install --lockfile-only --no-frozen-lockfile >/dev/null
      pnpm install --frozen-lockfile --lockfile-only >/dev/null 2>&1 \
        || die "Lockfile passt auch nach dem Nachziehen nicht (pnpm install --frozen-lockfile --lockfile-only in ~/vitalos prüfen)"
      if git diff --quiet -- pnpm-lock.yaml; then
        info "pnpm-lock.yaml unverändert"
      else
        git commit -q -m "fix(lock): pnpm-lock.yaml an die Modul-package.json angepasst (vos-ship $module)

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>" -- pnpm-lock.yaml
        info "pnpm-lock.yaml committet (wird mit dem Pointer in einem Push ausgeliefert)"
      fi
    )
    run_release || die "vos-release auch nach dem Lockfile-Nachziehen fehlgeschlagen — Ausgabe oben prüfen"
  else
    die "vos-release fehlgeschlagen (kein Lockfile-Problem) — Ausgabe oben prüfen"
  fi
fi

# ── 4. Nachlauf ────────────────────────────────────────────────────────────────
step "4/4 Nachlauf"
if [[ "$LIVE_FAILED_LOCK" -eq 1 && -n "$LIVE_WORKFLOW" ]]; then
  info "Live-Deploy war am Lockfile gescheitert — starte \"$LIVE_WORKFLOW\" neu"
  gh workflow run "$LIVE_WORKFLOW" -R "$repo" --ref "$LIVE_BRANCH"
  sleep 8
  new_id="$(gh run list -R "$repo" --workflow "$LIVE_WORKFLOW" --limit 1 --json databaseId --jq '.[0].databaseId')"
  if "$SCRIPT_DIR/gh-run-check" --repo "$repo" --timeout "$DEPLOY_TIMEOUT" "$new_id"; then
    info "Live-Deploy (Neustart) erfolgreich"
  else
    die "Live-Deploy (Neustart) fehlgeschlagen: gh run view $new_id -R $repo --log-failed"
  fi
else
  info "kein Neustart nötig"
fi

if [[ "$FUNCTIONS" -eq 1 ]]; then
  step "8/8 Push-Function deployen ($module)"
  run_url="$(gh workflow run deploy-push-functions.yml -R nimmsel23/vitalos --ref master -f "app=$module")"
  run_id="${run_url##*/}"
  [[ "$run_id" =~ ^[0-9]+$ ]] || die "Workflow-Run-ID nicht erkannt: $run_url"
  "$SCRIPT_DIR/gh-run-check" --repo nimmsel23/vitalos --timeout "$DEPLOY_TIMEOUT" "$run_id" \
    || die "Push-Function-Deploy fehlgeschlagen; siehe Run $run_id"
else
  info "Functions übersprungen; bei Bedarf mit --functions erneut als gezielten Release starten."
fi
info "fertig: $module Shell-Pin auf origin/master (${master_sha:0:7})."
info "Run prüfen: gh-run-check --repo nimmsel23/vitalos --latest --workflow deploy-push-functions.yml"
