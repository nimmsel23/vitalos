#!/usr/bin/env bash
# vos-portal — Dev-Dashboard neu erzeugen: docs/apps.{json,html} je Repo,
# portal/{registry.json,index.html,dev-status.json}, docs/dev-dashboard.html (Pages).
# Verteilt zuerst scripts/portal.mjs in alle Repos aus portal/repos.json. --check: nur prüfen.
# Doku/Ownership: docs/DEV-DASHBOARD.md (CTO pflegt, PM liest).
set -euo pipefail
meta="$(cd "$(dirname "$0")/.." && pwd)"; root="${VOS_DEV_ROOT:-$HOME/dev}"
for r in $(jq -r '.[]' "$meta/portal/repos.json"); do
  [ -d "$root/$r" ] && mkdir -p "$root/$r/scripts" && cp "$meta/scripts/vos-portal.mjs" "$root/$r/scripts/portal.mjs"
done
exec node "$meta/scripts/vos-portal.mjs" --all "$root" "$@"
