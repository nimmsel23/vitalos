#!/usr/bin/env bash
# vos-portal — Dev-Dashboard neu erzeugen: docs/apps.{json,html} je Repo,
# portal/{registry.json,index.html,dev-status.json}, docs/dev-dashboard.html (Pages).
# Verteilt zuerst scripts/portal.mjs in alle Repos aus portal/repos.json. --check: nur prüfen.
# Ohne --check werden die erzeugten Dateien je Dev-Repo gleich committet (nur
# diese Pfade, kein Push), damit keine Portal-Reste als WIP liegen bleiben.
# Doku/Ownership: docs/DEV-DASHBOARD.md (CTO pflegt, PM liest).
set -euo pipefail
meta="$(cd "$(dirname "$0")/.." && pwd)"; root="${VOS_DEV_ROOT:-$HOME/dev}"
repos=$(jq -r '.[]' "$meta/portal/repos.json")
for r in $repos; do
  [ -d "$root/$r" ] && mkdir -p "$root/$r/scripts" && cp "$meta/scripts/vos-portal.mjs" "$root/$r/scripts/portal.mjs"
done
node "$meta/scripts/vos-portal.mjs" --all "$root" "$@"

case " $* " in *" --check "*) exit 0 ;; esac

commit() { # <repo-dir> <pfade…>
  local dir="$1"; shift
  local paths=(); for p in "$@"; do [ -e "$dir/$p" ] && paths+=("$p"); done
  [ ${#paths[@]} -gt 0 ] || return 0
  git -C "$dir" add -- "${paths[@]}"
  git -C "$dir" diff --cached --quiet -- "${paths[@]}" && return 0
  git -C "$dir" commit -q -m "portal: App-Links neu erzeugt (vos-portal)" -- "${paths[@]}" \
    && echo "committet: $dir"
}
for r in $repos; do
  [ -e "$root/$r/.git" ] || continue
  commit "$root/$r" scripts/portal.mjs docs/apps.json docs/apps.html
done
# Meta-Repo (portal/*, docs/apps.html) bewusst NICHT: dessen pre-commit-Hook
# staged Submodul-Pointer + pnpm-lock.yaml mit. Dort von Hand committen.
