{
  "name": "vos-fitness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.cjs --port 9140",
    "build": "VITE_APP_MODE=client vite build --config vite.config.cjs",
    "preview": "vite preview",
    "build:cloud": "npm run build",
    "firebase": "npm run build && npm run deploy",
    "deploy": "firebase deploy --only hosting --project fitness-aos",
    "deploy:cloud": "npm run deploy"
  }
}
