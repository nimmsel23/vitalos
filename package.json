{
  "name": "vitalos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "vite",
    "build:fitness-kb-data": "pnpm --filter fitness-dev run build:kb-data",
    "build:6pack-data": "pnpm --filter 6pack run build:data",
    "prebuild": "pnpm run build:fitness-kb-data && pnpm run build:6pack-data",
    "build": "vite build && node packages/mini-app-shell/cli.mjs sw dist --app vitalos && node packages/mini-app-shell/cli.mjs splash dist --app vitalos",
    "prebuild:firebase": "pnpm run build:fitness-kb-data && pnpm run build:6pack-data",
    "build:firebase": "vite build --mode firebase && pnpm run stamp:sw",
    "stamp:sw": "node packages/mini-app-shell/cli.mjs sw dist-firebase --app vitalos && node packages/mini-app-shell/cli.mjs splash dist-firebase --app vitalos",
    "deploy:preview": "pnpm run build:firebase && pnpm dlx firebase-tools@latest hosting:channel:deploy agent-preview --expires 3d --project fitness-aos",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/accessibility": "^3.1.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@firebase/ai": "^1.4.1",
    "@firebase/analytics": "^0.10.17",
    "@firebase/app": "^0.13.2",
    "@firebase/app-check": "^0.10.1",
    "@firebase/auth": "^1.10.8",
    "@firebase/component": "^0.6.18",
    "@firebase/data-connect": "^0.3.10",
    "@firebase/database": "^1.0.20",
    "@firebase/firestore": "^4.8.0",
    "@firebase/functions": "^0.12.9",
    "@firebase/installations": "^0.6.18",
    "@firebase/logger": "^0.4.4",
    "@firebase/messaging": "^0.12.22",
    "@firebase/performance": "^0.7.7",
    "@firebase/remote-config": "^0.6.5",
    "@firebase/storage": "^0.13.14",
    "@firebase/util": "^1.12.1",
    "@firebase/webchannel-wrapper": "^1.0.3",
    "@fullcalendar/core": "^6.1.15",
    "@fullcalendar/daygrid": "^6.1.15",
    "@fullcalendar/interaction": "^6.1.15",
    "@fullcalendar/react": "^6.1.15",
    "@fullcalendar/timegrid": "^6.1.15",
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dismissable-layer": "^1.1.14",
    "@tanstack/react-query": "^5.101.0",
    "@vos/cross-app-aliases": "workspace:*",
    "body-muscles": "^1.0.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "firebase": "^11.10.0",
    "framer-motion": "^12.40.0",
    "idb": "^7.1.1",
    "js-yaml": "^4.1.1",
    "lucide-react": "^0.453.0",
    "marked": "^18.0.5",
    "motion-dom": "^12.40.0",
    "motion-utils": "^12.39.0",
    "react": "^18.3.1",
    "react-body-highlighter": "^2.0.5",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-is": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-muscle-highlighter": "^1.2.0",
    "reactflow": "^11.11.4",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.5.3",
    "tslib": "^2.8.1",
    "web-vitals": "^4.2.4",
    "yaml": "^2.9.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.4",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.0"
  }
}
