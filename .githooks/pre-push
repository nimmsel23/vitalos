#!/bin/bash
# pre-push hook — vitalos
# Stellt sicher dass pnpm-lock.yaml vor jedem Push nach master aktuell ist.
# Läuft automatisch bei `git push` — kein manueller Schritt nötig.

REMOTE_NAME="$1"
REMOTE_URL="$2"

# Lies alle zu pushenden Refs aus stdin
PUSHING_MASTER=false
while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "$remote_ref" == "refs/heads/master" ]]; then
    PUSHING_MASTER=true
  fi
done

if [ "$PUSHING_MASTER" = false ]; then
  exit 0
fi

cd "$(git rev-parse --show-toplevel)"

# Prüfe ob Lockfile mit allen package.json übereinstimmt
if pnpm install --frozen-lockfile --ignore-scripts 2>/dev/null; then
  exit 0
fi

echo ""
echo "⚠️  pnpm-lock.yaml ist nicht synchron mit package.json(s) — aktualisiere..."
pnpm install --ignore-scripts

# Prüfe ob sich das Lockfile tatsächlich geändert hat
if git diff --quiet pnpm-lock.yaml; then
  echo "✅ Lockfile war schon korrekt (pnpm-Fehler ignoriert)"
  exit 0
fi

git add pnpm-lock.yaml
git commit --amend --no-edit --no-verify
echo "✅ pnpm-lock.yaml aktualisiert und in letzten Commit aufgenommen"
echo ""
