{
  "firestore": {
    "rules": "firestore.product.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "target": "vitalos",
    "public": "dist-firebase",
    "predeploy": ["node scripts/ci-deploy-guard.mjs"],
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/datenschutz", "destination": "/datenschutz/index.html" },
      { "source": "/datenschutz/", "destination": "/datenschutz/index.html" },
      { "source": "/konto-loeschen", "destination": "/konto-loeschen/index.html" },
      { "source": "/konto-loeschen/", "destination": "/konto-loeschen/index.html" },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      { "source": "**", "headers": [{ "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }] },
      { "source": "**/*.@(js|css|woff2)", "headers": [{ "key": "Cache-Control", "value": "max-age=31536000, immutable" }] },
      { "source": "/vitalos-messaging-sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/manifest.json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/datenschutz", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/datenschutz/**", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/konto-loeschen", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/konto-loeschen/**", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  },
  "functions": {
    "codebase": "vitalos",
    "source": "functions",
    "runtime": "nodejs22"
  }
}
